// TypeScript compiler settings for type-checking the Playwright project without emitting JavaScript.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node", "@playwright/test"]
  },
  // Limit type-checking to test code, Page Objects, API clients, and Playwright configuration.
  "include": ["tests/**/*.ts", "POM/**/*.ts", "API/**/*.ts", "playwright.config.ts", "reporter.ts"]
}
